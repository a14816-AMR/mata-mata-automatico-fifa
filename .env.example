# ---- Backend (FastAPI) — copiar para .env em desenvolvimento; definir na Vercel em produção
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key (sb_secret_...) ou a antiga service_role (eyJ...): NUNCA expor no frontend
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Palavra-passe da área de administração
ADMIN_PASSWORD=mude-esta-palavra-passe
# Segredo aleatório para assinar as sessões (ex.: python -c "import secrets;print(secrets.token_hex(32))")
ADMIN_TOKEN_SECRET=
# Duração da sessão de administrador, em horas
ADMIN_TOKEN_TTL_HOURS=24
# Origens permitidas (só relevante se o frontend estiver noutro domínio)
CORS_ORIGINS=*

# ---- Frontend (Vite) — na Vercel, definir também estas duas
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) ou a antiga anon (eyJ...)
VITE_SUPABASE_ANON_KEY=sb_publishable_...
